#!/bin/sh
# Ratewise AppImage entry point.
#
# Libraries: the AppImage carries fallback copies of the window's libraries (built
# against glibc 2.28). A copy is used only when the host lacks that library: a
# desktop's own X11/Wayland libraries match its GPU driver, and mixing old and new
# copies is what usually breaks AppImages.
#
# Fonts: Slint's font code panics when fontconfig finds no fonts at all, as on
# minimal systems. Then a fontconfig file is generated that adds the bundled Inter
# to whatever the host has.
#
# Troubleshooting: RATEWISE_LIBS=bundled|host forces every bundled library or none,
# RATEWISE_FONTS=bundled forces the generated font setup, and RATEWISE_LIBS_DEBUG=1
# prints what was chosen. Anything generated goes in a temporary folder that's
# removed on exit.

here=$(dirname "$(readlink -f "$0")")
bin=$here/usr/bin/ratewise
fallback=$here/usr/lib/ratewise

scratch=
make_scratch() {
    [ -n "$scratch" ] && return 0
    scratch=$(mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/ratewise.XXXXXX" 2>/dev/null ||
        mktemp -d 2>/dev/null) || scratch=
    [ -n "$scratch" ]
}

host_has() {
    # For tests: pretend these are missing on the host.
    case " ${RATEWISE_LIBS_MISSING:-} " in *" $1 "*) return 1 ;; esac
    for d in /lib64 /usr/lib64 /lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu /usr/lib /lib; do
        [ -e "$d/$1" ] && return 0
    done
    for ldc in ldconfig /sbin/ldconfig /usr/sbin/ldconfig; do
        if "$ldc" -p >/dev/null 2>&1; then
            "$ldc" -p 2>/dev/null | grep -q "[[:space:]]$1 " && return 0
            return 1
        fi
    done
    return 1
}

# ---- libraries
mode=${RATEWISE_LIBS:-auto}
libs=
missing=
case $mode in
    host) ;;
    bundled)
        libs=$fallback
        missing=" (all)"
        ;;
    *)
        for f in "$fallback"/*.so*; do
            [ -e "$f" ] || continue
            n=$(basename "$f")
            host_has "$n" || missing="$missing $n"
        done
        # Libraries that must come from the same place: libxkbcommon-x11 uses
        # libxkbcommon's internals, and mixing a bundled one with the host's other
        # one crashes. If either is missing, use both bundled copies.
        for group in "libxkbcommon.so.0 libxkbcommon-x11.so.0"; do
            take=
            for n in $group; do
                case " $missing " in *" $n "*) take=1 ;; esac
            done
            [ -n "$take" ] || continue
            for n in $group; do
                case " $missing " in *" $n "*) ;; *) missing="$missing $n" ;; esac
            done
        done
        if [ -n "$missing" ]; then
            if make_scratch; then
                # Links to just the missing ones.
                mkdir "$scratch/lib"
                for n in $missing; do ln -s "$fallback/$n" "$scratch/lib/$n"; done
                libs=$scratch/lib
            else
                libs=$fallback
            fi
        fi
        ;;
esac
if [ -n "$libs" ]; then
    LD_LIBRARY_PATH=$libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export LD_LIBRARY_PATH
fi

# ---- fonts
host_fonts() {
    [ -e /etc/fonts/fonts.conf ] || return 1
    if command -v fc-list >/dev/null 2>&1; then
        [ -n "$(fc-list 2>/dev/null | head -n 1)" ]
        return
    fi
    for d in /usr/share/fonts /usr/local/share/fonts "${XDG_DATA_HOME:-$HOME/.local/share}/fonts" "$HOME/.fonts"; do
        [ -d "$d" ] || continue
        [ -n "$(find "$d" -type f \( -name '*.ttf' -o -name '*.otf' -o -name '*.ttc' -o -name '*.pcf*' \) 2>/dev/null | head -n 1)" ] && return 0
    done
    return 1
}
fonts=host
if [ -z "${FONTCONFIG_FILE:-}" ] && { [ "${RATEWISE_FONTS:-}" = bundled ] || ! host_fonts; }; then
    if make_scratch; then
        # Absolute paths: older fontconfig (such as the bundled 2.13) doesn't know
        # prefix="relative". No cachedir, so nothing is written.
        cat >"$scratch/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <include ignore_missing="yes">/etc/fonts/fonts.conf</include>
  <dir>$here/usr/share/ratewise/fonts</dir>
  <dir>/usr/share/fonts</dir>
  <dir>/usr/local/share/fonts</dir>
</fontconfig>
EOF
        FONTCONFIG_FILE=$scratch/fonts.conf
        export FONTCONFIG_FILE
        fonts=bundled
    fi
fi

if [ -n "${RATEWISE_LIBS_DEBUG:-}" ]; then
    echo "ratewise AppRun: libraries $mode, bundled copies used:${missing:- none}; fonts: $fonts" >&2
fi

if [ -z "$scratch" ]; then
    exec "$bin" "$@"
fi
trap 'rm -rf "$scratch"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
"$bin" "$@"
