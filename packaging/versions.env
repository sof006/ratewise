# Pinned packaging inputs. build-appimage.sh downloads these into the tools cache
# (RATEWISE_TOOLS, default ~/.cache/ratewise-tools) and checks each SHA-256.

APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_FILE=appimagetool-1.9.1-x86_64.AppImage
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0

# The static type2 runtime: no libfuse2 needed on the host (spec §6.2).
RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
RUNTIME_FILE=runtime-20251108-x86_64
RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

# Bundled libraries come from Debian 10 (glibc 2.28, the floor).
DEBIAN_MIRROR=http://archive.debian.org/debian
DEBIAN_SUITE=buster
DEBIAN_PACKAGES_SHA256=895f3926ff51f89f86f7aad95538c3e30982f94596dd7ddf3961c9df6682feac
